# =====================================================================
# SecureBank backend - variables de entorno (EJEMPLO)
# Copia este archivo a backend/.env y cambia TODOS los valores.
# backend/.env esta ignorado por Git: nunca lo subas al repositorio.
# =====================================================================

# Conexion a PostgreSQL desde el host (puerto publicado 5433).
DATABASE_URL=postgresql://securebank:cambia_esta_clave_de_ejemplo@localhost:5433/securebank?schema=public

# Redis local.
REDIS_URL=redis://localhost:6379

# RabbitMQ local (AMQP).
RABBITMQ_URL=amqp://securebank:cambia_esta_clave_de_ejemplo@localhost:5672

# Secreto para firmar JWT (usa un valor largo y aleatorio).
JWT_SECRET=cambia_este_secreto_de_ejemplo_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=1h

# Puerto HTTP de NestJS.
PORT=3000
