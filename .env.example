@'
PORT=3000

POSTGRES_DB=securebank
POSTGRES_USER=securebank
POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql://securebank:CHANGE_ME@postgres:5432/securebank

REDIS_HOST=redis
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=securebank
RABBITMQ_PASSWORD=CHANGE_ME

JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=1h
'@ | Set-Content -Encoding utf8 .env.example
if (!(Test-Path .env)) {
    Copy-Item .env.example .env
}