# =====================================================================
# SecureBank - variables de entorno (EJEMPLO)
# Copia este archivo a .env y cambia TODOS los valores de ejemplo.
# .env esta ignorado por Git: nunca lo subas al repositorio.
# =====================================================================

# --- Backend local ---
PORT=3000

# --- Puertos publicados en el host (desarrollo local) ---
# El valor por defecto conserva el acceso solo por loopback.
# En la VM de Azure, Ansible genera un .env con FRONTEND_BIND_ADDRESS=0.0.0.0
# y FRONTEND_PORT=80 para que Nginx sea accesible a traves del NSG.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=3000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080

# --- PostgreSQL (requeridas por docker-compose.yml) ---
# Puerto del host: 5433. Dentro de la red Docker el puerto es 5432.
POSTGRES_DB=securebank
POSTGRES_USER=securebank
POSTGRES_PASSWORD=cambia_esta_clave_de_ejemplo

# Conexion usada por el backend cuando corre en el host (npm run start:dev).
DATABASE_URL=postgresql://securebank:cambia_esta_clave_de_ejemplo@localhost:5433/securebank?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- RabbitMQ (requeridas por docker-compose.yml) ---
# AMQP en localhost:5672; panel de administracion en http://localhost:15672
RABBITMQ_USER=securebank
RABBITMQ_PASSWORD=cambia_esta_clave_de_ejemplo
RABBITMQ_URL=amqp://securebank:cambia_esta_clave_de_ejemplo@localhost:5672

# --- Seguridad ---
JWT_SECRET=cambia_este_secreto_de_ejemplo_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=1h
