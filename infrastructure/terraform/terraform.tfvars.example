# Copy to terraform.tfvars locally. This file is ignored by Git.
location       = "eastus"
environment    = "qa"
admin_username = "securebankadmin"
vm_size        = "Standard_B2s"

# Replace with the public IP of the administrator, never 0.0.0.0/0.
# Set to null to keep SSH closed in the NSG.
allowed_ssh_cidr = "203.0.113.10/32"

# Public key only (contents of ~/.ssh/securebank_qa.pub).
# Do not place a private key in this file or repository.
ssh_public_key = "ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY securebank-qa"

