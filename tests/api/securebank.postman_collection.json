{
  "info": {
    "name": "SecureBank QA - ejecución automatizada y negativa",
    "description": "Importar en Insomnia; crear entorno QA con credenciales sintéticas. Orden importante: login A, cuentas A, login B, cuentas B, casos de prueba. No incluye operaciones que cambien saldos. Ejecutar en ambiente de pruebas autorizado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API-01 login válido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "API-01 login válido",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{qaEmail}}\", \"password\": \"{{qaPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 - API-01 login válido', () => pm.response.to.have.status(200));",
              "pm.test('JWT emitido', () => pm.expect(pm.response.json().access_token).to.be.a('string'));",
              "pm.environment.set('accessToken', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
