# URL base que usa el cliente HTTP del frontend.
# En desarrollo se recomienda dejar /api para aprovechar el proxy de Vite
# y evitar problemas de CORS con el backend.
VITE_API_URL=/api

# Destino del proxy de Vite (solo desarrollo/preview).
VITE_PROXY_TARGET=http://localhost:3000

# Alternativa sin proxy: requiere que el backend habilite CORS.
# VITE_API_URL=http://localhost:3000/api
